local function SetVFX(data, folderName)
    local folder = player:FindFirstChild(folderName)
    if not folder then return end
    local shifted = folder:FindFirstChild("Shifted")
    if shifted then
        shifted:SetAttribute("Shifted_Color1", data.s1)
        shifted:SetAttribute("Shifted_Color2", data.s2)
        shifted:SetAttribute("Shifted_Color3", data.s3)
    end
    folder:SetAttribute("GrayscaleToColorStrength", data.strength)
    folder:SetAttribute("GrayscaleToColorSequence", data.seq)
end

local function ApplyEagle(name)
    local data = SkinData.Eagle[name]
    if not data then return end
    local charsFolder = workspace:FindFirstChild("Characters")
    local char = charsFolder and charsFolder:FindFirstChild(player.Name)
    local wings = char and char:FindFirstChild("Wings", true)
    if wings and wings:IsA("MeshPart") then
        local sa = wings:FindFirstChildOfClass("SurfaceAppearance")
        if sa then
            sa.ColorMap     = data.ColorMap
            sa.RoughnessMap = data.RoughnessMap
            sa.TexturePack  = data.TexturePack
        end
    end
    SetVFX(data, "EagleFruitVFXColor")
end

local function ApplyDiamond(name)
    local data = SkinData.Diamond[name]
    if not data then return end
    local targetFolder = nil
    for _, v in ipairs(player:GetChildren()) do
        if v:IsA("Folder") and string.find(v.Name, "VFXColor") then
            targetFolder = v.Name
            break
        end
    end
    if targetFolder then SetVFX(data, targetFolder) end
end

local function buildUI(design)
    local Astral = getActiveLib(design)

    local Window = Astral:CreateWindow({ Title = "Lumu", AutoLoad = true, AutoLoadConfig = true, ConfigName = "lumu_autoload.json" })

    local InfoTab = Window:MakeTab({ "Info", "Badge Star" })

    InfoTab:AddParagraph({
        Title = "Credits",
        Description = "Lumu UI was built with love by:\n\n•  Velaric\n•  Lucas\n•  Kismile\n\nThanks for using our project. Enjoy!",
        Image = "rbxassetid://17160800734"
    })

    InfoTab:AddDiscordCard({ ServerData = {
        ServerName  = "LumuHub Community",
        Description = "Join our Discord for updates, skins & support",
        InviteCode  = "xUKZJBXM",
        OnlineCount = 29,
        MemberCount = 29,
    }})

    local SkinsTab = Window:MakeTab({ "Skins", "Fruit" })

    SkinsTab:AddLabel({ Title = "Eagle Skin", Description = "Tap a style to apply it" })

    local eagleButtons = {}
    for name, _ in pairs(SkinData.Eagle) do
        table.insert(eagleButtons, {
            Title = name,
            Color = "blue",
            Callback = function()
                ApplyEagle(name)
                Window:Notify({ Type = "good", Title = "Eagle Skin", Message = "Applied: " .. name, Duration = 3 })
            end,
        })
    end
    SkinsTab:AddMultiButton({ Title = "Eagle Styles", Columns = 2, Buttons = eagleButtons })

    SkinsTab:AddLabel({ Title = "Diamond Skin", Description = "Tap a colour to apply it" })

    local diamondButtons = {}
    for name, _ in pairs(SkinData.Diamond) do
        table.insert(diamondButtons, {
            Title = name,
            Color = "cyan",
            Callback = function()
                ApplyDiamond(name)
                Window:Notify({ Type = "good", Title = "Diamond Skin", Message = "Applied: " .. name, Duration = 3 })
            end,
        })
    end
    SkinsTab:AddMultiButton({ Title = "Diamond Colours", Columns = 2, Buttons = diamondButtons })

    return Window
end

